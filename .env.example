# Required for live trip generation (keys are never sent to the browser)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GEOAPIFY_API_KEY=your_geoapify_api_key

# Optional: enables PostgreSQL persistence. Browser-local saved trips work without it.
# DATABASE_URL="postgresql://travelsetu:travelsetu@localhost:5432/travelsetu?schema=public"
