generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlaceCategory {
  MUST_SEE
  HIDDEN_GEM
  LOCAL_EXPERIENCE
  FOOD_STOP
  NATURE_ESCAPE
  CULTURAL_EXPERIENCE
  PHOTO_SPOT
  RELAXATION
  ADVENTURE
}

enum BudgetCategory {
  ACCOMMODATION
  INTERCITY_TRANSPORT
  FOOD
  ACTIVITIES
  LOCAL_TRANSPORT
  MISCELLANEOUS
}

model User {
  id          String           @id @default(cuid())
  name        String?
  email       String?          @unique
  createdAt   DateTime         @default(now())
  preferences UserPreference?
  trips       Trip[]
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  originCity         String?
  travelStyle        String?
  interests          String[] @default([])
  preferredTransport String[] @default([])
  foodPreferences    String[] @default([])
  accommodation      String?
  budgetPerDayPaise  Int?
  defaultTravelers   Int      @default(1)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Destination {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  state              String
  region             String?
  description        String
  bestSeason          String
  seasonalNotes       String?
  typicalDailyMinPaise Int?
  typicalDailyMaxPaise Int?
  places               Place[]
  trips                Trip[]
}

model Place {
  id             String        @id @default(cuid())
  destinationId  String
  name           String
  neighborhood   String?
  category       PlaceCategory
  description    String
  latitude       Float
  longitude      Float
  durationMin    Int
  costMinPaise   Int?
  costMaxPaise   Int?
  openingHours   Json?
  bestTime       String?
  etiquette      String?
  destination    Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  activities     Activity[]
  @@index([destinationId, neighborhood])
}

model TransportationOption {
  id               String          @id @default(cuid())
  mode             String
  label            String
  typicalSpeedKmh  Float?
  costMinPaise     Int?
  costMaxPaise     Int?
  notes            String?
  activityLinks    ActivityTransport[]
  itineraryItems   ItineraryItem[]
}

model Activity {
  id                  String          @id @default(cuid())
  placeId             String
  title               String
  description         String
  timeOfDay           String
  durationMin         Int
  costMinPaise        Int?
  costMaxPaise        Int?
  recommendedReason   String
  alternateActivityId String?
  place               Place           @relation(fields: [placeId], references: [id], onDelete: Cascade)
  transports          ActivityTransport[]
  itineraryItems      ItineraryItem[]
  @@index([placeId, timeOfDay])
}

model ActivityTransport {
  activityId           String
  transportationOptionId String
  activity              Activity              @relation(fields: [activityId], references: [id], onDelete: Cascade)
  transportationOption  TransportationOption  @relation(fields: [transportationOptionId], references: [id], onDelete: Cascade)
  @@id([activityId, transportationOptionId])
}

model Trip {
  id              String          @id @default(cuid())
  userId          String
  destinationId   String
  originCity      String
  startsOn        DateTime?
  dayCount        Int
  travelers       Int
  travelStyle     String
  status          String          @default("DRAFT")
  plannerPayload  Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination     Destination     @relation(fields: [destinationId], references: [id])
  days            ItineraryDay[]
  budget          Budget?
  @@index([userId, updatedAt])
}

model ItineraryDay {
  id           String          @id @default(cuid())
  tripId       String
  dayNumber    Int
  title        String
  neighborhood String?
  routeKm      Float?
  trip         Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items        ItineraryItem[]
  @@unique([tripId, dayNumber])
}

model ItineraryItem {
  id                       String                 @id @default(cuid())
  dayId                    String
  activityId               String?
  transportationOptionId   String?
  sortOrder                Int
  title                    String
  description              String?
  category                 String?
  timeOfDay                String
  durationMin              Int
  costPaise                Int?
  distanceFromPreviousKm   Float?
  userNote                 String?
  day                      ItineraryDay           @relation(fields: [dayId], references: [id], onDelete: Cascade)
  activity                 Activity?              @relation(fields: [activityId], references: [id], onDelete: SetNull)
  transportationOption     TransportationOption?  @relation(fields: [transportationOptionId], references: [id], onDelete: SetNull)
  @@unique([dayId, sortOrder])
  @@index([dayId, timeOfDay])
}

model Budget {
  id              String        @id @default(cuid())
  tripId          String        @unique
  currency        String        @default("INR")
  estimatedPaise  Int
  perPersonPaise  Int
  dailyPaise      Int
  trip            Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lines           BudgetLine[]
}

model BudgetLine {
  id            String         @id @default(cuid())
  budgetId      String
  category      BudgetCategory
  amountPaise   Int
  notes         String?
  budget        Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  @@unique([budgetId, category])
}
